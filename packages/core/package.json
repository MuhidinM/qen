{
  "name": "@qen/core",
  "version": "0.0.0",
  "description": "Zero-dependency Gregorian, Ethiopian, and Hijri calendar engine: conversion, arithmetic, formatting, and holidays.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "calendar",
    "ethiopian",
    "hijri",
    "gregorian",
    "date",
    "conversion",
    "holidays"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuhidinM/qen.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}

{
  "name": "@qen/core",
  "version": "0.3.0",
  "description": "Zero-dependency Gregorian, Ethiopian, and Hijri calendar engine: conversion, arithmetic, formatting, and holidays.",
  "license": "MIT",
  "author": "Muhidin Misbah",
  "homepage": "https://github.com/MuhidinM/qen/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/MuhidinM/qen/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./locales/en": {
      "import": {
        "types": "./dist/locales/en.d.ts",
        "default": "./dist/locales/en.js"
      },
      "require": {
        "types": "./dist/locales/en.d.cts",
        "default": "./dist/locales/en.cjs"
      }
    },
    "./locales/am": {
      "import": {
        "types": "./dist/locales/am.d.ts",
        "default": "./dist/locales/am.js"
      },
      "require": {
        "types": "./dist/locales/am.d.cts",
        "default": "./dist/locales/am.cjs"
      }
    },
    "./locales/om": {
      "import": {
        "types": "./dist/locales/om.d.ts",
        "default": "./dist/locales/om.js"
      },
      "require": {
        "types": "./dist/locales/om.d.cts",
        "default": "./dist/locales/om.cjs"
      }
    },
    "./locales/ti": {
      "import": {
        "types": "./dist/locales/ti.d.ts",
        "default": "./dist/locales/ti.js"
      },
      "require": {
        "types": "./dist/locales/ti.d.cts",
        "default": "./dist/locales/ti.cjs"
      }
    },
    "./locales/ar": {
      "import": {
        "types": "./dist/locales/ar.d.ts",
        "default": "./dist/locales/ar.js"
      },
      "require": {
        "types": "./dist/locales/ar.d.cts",
        "default": "./dist/locales/ar.cjs"
      }
    },
    "./overrides/ethiopia": {
      "import": {
        "types": "./dist/overrides/ethiopia.d.ts",
        "default": "./dist/overrides/ethiopia.js"
      },
      "require": {
        "types": "./dist/overrides/ethiopia.d.cts",
        "default": "./dist/overrides/ethiopia.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "calendar",
    "ethiopian",
    "hijri",
    "gregorian",
    "date",
    "conversion",
    "holidays"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuhidinM/qen.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "size": "size-limit",
    "smoke": "sh smoke/run.sh node",
    "generate:umalqura": "node scripts/generate-umalqura.mjs",
    "check:umalqura": "node scripts/generate-umalqura.mjs --check",
    "docs": "typedoc",
    "check:docs": "typedoc --json docs-api/api.json && node scripts/check-examples.mjs docs-api/api.json",
    "check:readme": "node scripts/check-readme.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "size-limit": [
    {
      "name": "everything (main entry)",
      "path": "dist/index.js",
      "limit": "9 kB"
    },
    {
      "name": "{ date, convert } (includes the Umm al-Qura table)",
      "path": "dist/index.js",
      "import": "{ date, convert }",
      "limit": "3 kB"
    },
    {
      "name": "{ format }",
      "path": "dist/index.js",
      "import": "{ format }",
      "limit": "3.5 kB"
    },
    {
      "name": "{ parse }",
      "path": "dist/index.js",
      "import": "{ parse }",
      "limit": "4 kB"
    },
    {
      "name": "{ getHolidays, nextHoliday }",
      "path": "dist/index.js",
      "import": "{ getHolidays, nextHoliday }",
      "limit": "4.5 kB"
    },
    {
      "name": "{ toGeezNumeral }",
      "path": "dist/index.js",
      "import": "{ toGeezNumeral }",
      "limit": "500 B"
    },
    {
      "name": "{ toEthiopianTime }",
      "path": "dist/index.js",
      "import": "{ toEthiopianTime }",
      "limit": "400 B"
    },
    {
      "name": "locale: en",
      "path": "dist/locales/en.js",
      "limit": "1.5 kB"
    },
    {
      "name": "locale: am",
      "path": "dist/locales/am.js",
      "limit": "1.5 kB"
    },
    {
      "name": "locale: om",
      "path": "dist/locales/om.js",
      "limit": "1.5 kB"
    },
    {
      "name": "locale: ti",
      "path": "dist/locales/ti.js",
      "limit": "1.5 kB"
    },
    {
      "name": "locale: ar",
      "path": "dist/locales/ar.js",
      "limit": "1.5 kB"
    },
    {
      "name": "overrides: ethiopia",
      "path": "dist/overrides/ethiopia.js",
      "limit": "1 kB"
    }
  ]
}

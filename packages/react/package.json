{
  "name": "@qen/react",
  "version": "0.1.0",
  "description": "Accessible React components for Gregorian, Ethiopian and Hijri dates, built on @qen/core.",
  "license": "MIT",
  "author": "Muhidin Misbah",
  "homepage": "https://github.com/MuhidinM/qen/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/MuhidinM/qen/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "calendar",
    "date picker",
    "ethiopian",
    "hijri",
    "accessible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuhidinM/qen.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "size": "size-limit",
    "stories": "ladle serve",
    "build:stories": "ladle build"
  },
  "size-limit": [
    {
      "name": "{ DateText } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ DateText }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "1 kB"
    },
    {
      "name": "{ CalendarGrid } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ CalendarGrid }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "3 kB"
    },
    {
      "name": "{ DatePicker } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ DatePicker }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "4.5 kB"
    },
    {
      "name": "{ DateRangePicker } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ DateRangePicker }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "3.5 kB"
    },
    {
      "name": "{ EthiopianTimeInput } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ EthiopianTimeInput }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "1.5 kB"
    },
    {
      "name": "{ YearView } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ YearView }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "1.5 kB"
    },
    {
      "name": "{ AgendaView } without React and @qen/core",
      "path": "dist/index.js",
      "import": "{ AgendaView }",
      "ignore": [
        "react",
        "react-dom",
        "@qen/core"
      ],
      "limit": "1.5 kB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ladle/react": "^5.1.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@qen/core": "workspace:^"
  }
}
